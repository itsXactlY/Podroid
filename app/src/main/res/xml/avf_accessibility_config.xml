<?xml version="1.0" encoding="utf-8"?>
<!--
  Podroid - Rootless Podman for Android
  Copyright (C) 2024-2026 Podroid contributors

  AccessibilityService config for PodroidSetupAssistant (AVF auto-pair).
  - canRetrieveWindowContent: required so we can read node text (the pairing
    code + ports) and match by resource-id.
  - flagDefault: standard behaviour.
  - packageNames: we ONLY act inside the Settings app. The service guards this
    in code too, but declaring it here keeps the OS from routing other apps'
    windows to us (privacy + correctness).
  - The service is enabled by the user ONCE from podroid's first-run screen and
    disables itself automatically after the one-time grant.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/avf_accessibility_description"
    android:notificationTimeout="100"
    android:packageNames="com.android.settings"
    android:settingsActivity="com.android.settings.Settings\$DevelopmentSettingsDashboardActivity" />
