#!/bin/sh
# Replacement login shell for getty. Restores the terminal size from
# /run/term_size (written by podroid-resize on QEMU) before exec'ing the
# real login binary — virtio-console + PL011 serial both reset winsize
# to 0x0 on every getty respawn, so without this TUI apps (btop, htop,
# vim, less) bail with "Failed to get size of terminal".
#
# AVF doesn't run podroid-resize for ttyS0 (no SIGWINCH propagation
# channel yet), so /run/term_size won't exist there — fall back to a
# sensible default rather than leaving winsize at 0x0. The host-side
# TerminalView will overwrite this the moment the user touches the
# screen and triggers a real SIGWINCH.
_r=""
_c=""
if [ -r /run/term_size ]; then
    read _r _c < /run/term_size
fi
# Reject empty, non-numeric, and 0 (a 0x0 winsize is the exact failure this
# script exists to prevent: TUIs bail "Failed to get size of terminal").
case "$_r" in ''|*[!0-9]*|0) _r=24;; esac
case "$_c" in ''|*[!0-9]*|0) _c=80;; esac
stty rows "$_r" cols "$_c" 2>/dev/null
# ── Mandatory first-run password change ─────────────────────────────────
# The image ships a documented default (root/podroid). A documented default
# on a box that also runs an agent gateway is a credential everyone knows,
# so the first console session must replace it before anything else happens.
# There is no skip: the loop only exits once a new password is accepted.
#
# This runs as root (getty invokes us as its login program) and therefore
# before /bin/login, which is what makes it unskippable from the terminal.
#
# Undo for a re-provision:  rm /etc/podroid/password-set
# RESCUE HATCH. Typing `rescue` at the login prompt re-runs this flow even
# when the marker exists. It exists because the first version of this code
# could lock the operator out: if the password that got hashed differed from
# the one they typed (see the IFS/-r/CR bugs fixed below), the console
# rejected them and SSH was gated off, leaving no way back in short of
# wiping the VM's storage.
#
# This is only reachable from the local console, which already sits behind
# the phone's lock screen and the Podroid app, and it grants nothing without
# setting a NEW password that still has to pass the rules below. dropbear is
# untouched by it.
_forced=0
[ ! -f /etc/podroid/password-set ] && _forced=1
case "${1:-}" in rescue|RESCUE) _forced=1 ;; esac

if [ "$_forced" = "1" ]; then
    printf '\n'
    printf '  ####################################################\n'
    printf '  #  Podroid first-run: set a password               #\n'
    printf '  ####################################################\n'
    printf '\n'
    printf '  This image ships with a documented default login.\n'
    printf '  It must be replaced before you get a shell.\n'
    printf '\n'
    printf '  Requirements: at least 12 characters, and not the\n'
    printf '  default. Choose something only you know.\n'
    printf '\n'

    while :; do
        # `IFS= read -r` is load-bearing, and getting it wrong is what locked
        # the first tester out:
        #   * without IFS= the shell strips leading/trailing whitespace,
        #   * without -r a backslash is an escape and disappears,
        #   * a serial console can deliver a trailing CR.
        # Any of those hashes a DIFFERENT string than the operator typed, so
        # chpasswd succeeds, the marker is written, and the next login is
        # rejected forever. Strip only CR, never anything the user meant.
        printf '  New root password: '
        stty -echo 2>/dev/null
        IFS= read -r _pw1
        stty echo 2>/dev/null
        printf '\n  Repeat: '
        stty -echo 2>/dev/null
        IFS= read -r _pw2
        stty echo 2>/dev/null
        printf '\n'
        _pw1=$(printf '%s' "$_pw1" | tr -d '\r')
        _pw2=$(printf '%s' "$_pw2" | tr -d '\r')

        if [ "$_pw1" != "$_pw2" ]; then
            printf '  -> They do not match. Again.\n\n'
            continue
        fi
        # Rejected outright: the shipped default and its obvious variants.
        case "$_pw1" in
            podroid|Podroid|podroid123|root|toor|alpine|admin|password|changeme)
                printf '  -> That is a default/known password. Refused.\n\n'
                continue ;;
        esac
        if [ "${#_pw1}" -lt 12 ]; then
            printf '  -> Too short (%s chars, need 12+). Again.\n\n' "${#_pw1}"
            continue
        fi
        # Reject a single character class (all digits / all lower / all upper).
        case "$_pw1" in
            *[!0-9]*) ;;
            *) printf '  -> Digits only. Add letters or symbols.\n\n'; continue ;;
        esac
        case "$_pw1" in
            *[!a-z]*) ;;
            *) printf '  -> Lowercase only. Add digits, capitals or symbols.\n\n'; continue ;;
        esac
        case "$_pw1" in
            *[!A-Z]*) ;;
            *) printf '  -> Uppercase only. Add digits, lowercase or symbols.\n\n'; continue ;;
        esac

        if printf 'root:%s\n' "$_pw1" | chpasswd >/dev/null 2>&1; then
            mkdir -p /etc/podroid
            : > /etc/podroid/password-set
            chmod 0644 /etc/podroid/password-set
            printf '  Password set (%s characters). Log in with it now.\n' "${#_pw1}"
            printf '  If it is ever rejected, log in as: rescue\n\n'
            # SSH was withheld while the default was in place (see
            # /etc/init.d/podroid-sshd). Bring it up now rather than at the
            # next boot, so provisioning finishes in one session.
            rc-service podroid-sshd start >/dev/null 2>&1 || true
            unset _pw1 _pw2
            break
        fi
        printf '  -> chpasswd failed. Again.\n\n'
    done
fi

exec /bin/login "$@"
