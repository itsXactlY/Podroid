#!/sbin/openrc-run
# ────────────────────────────────────────────────────────────────────
# iris-pod — OpenRC init script for the iris-messenger pod running
# INSIDE the Podroid Alpine VM.
#
# This file lives at /etc/init.d/iris-pod inside the VM. Podroid's
# build-rootfs overlay mechanism (see android/podroid/build-rootfs/files/)
# makes it trivial to inject custom init scripts into the squashfs.
#
# Lifecycle:
#   - start: pull or load the iris-messenger arm64 image, run it as a
#            rootless podman container with bind-mounts for /var/lib/iris
#            (persistent state) and /etc/iris/runtime.env (config)
#   - stop:  podman stop iris-messenger
#   - status: podman ps | grep iris-messenger
#
# Note: this is the SCRIPT that runs inside the VM. The Android side
# (iris-android) does the podroid-forward setup to expose 9091/9092
# from the guest to the host's loopback.
# ────────────────────────────────────────────────────────────────────

name="iris-pod"
description="Iris Messenger pod (rootless container on Podroid)"

# Image name (must match the local-loaded image produced by
# build-podman-image.sh on the iris-messenger side). The arm64 vendor
# tarball is the slim Nuitka --onefile build (24 MB, tag :arm64, see
# Containerfile.nuitka-arm64) — small enough to load in the 512 MB VM,
# unlike the heavy from-source image. start_pre prefers the arm64 tar.
IRIS_IMAGE="${IRIS_IMAGE:-localhost/iris-messenger:arm64}"
IRIS_CONTAINER_NAME="${IRIS_CONTAINER_NAME:-iris-messenger}"

# Where persistent state lives (overlaid on the ext4 persistent volume
# that Podroid creates at /var/lib/podroid/upper, bind-mounted into the
# container).
IRIS_DATA_DIR="${IRIS_DATA_DIR:-/var/lib/iris}"
IRIS_CONFIG="${IRIS_CONFIG:-/etc/iris/runtime.env}"

# Container runtime knobs.
IRIS_HOST_PORT_REST="${IRIS_HOST_PORT_REST:-9091}"
IRIS_HOST_PORT_WS="${IRIS_HOST_PORT_WS:-9092}"
IRIS_CONTAINER_PORT_REST="${IRIS_CONTAINER_PORT_REST:-9091}"
IRIS_CONTAINER_PORT_WS="${IRIS_CONTAINER_PORT_WS:-9092}"

command="/usr/local/bin/iris-pod-start.sh"
command_background="yes"
pidfile="/run/${name}.pid"
start_stop_daemon_args="--background --make-pidfile --pidfile ${pidfile}"

depend() {
    need net
    need podman
    after podman
}

start_pre() {
    # Ensure persistent state dir exists with sane perms.
    if [ ! -d "${IRIS_DATA_DIR}" ]; then
        einfo "Creating ${IRIS_DATA_DIR} with mode 0700"
        mkdir -m 0700 -p "${IRIS_DATA_DIR}"
    fi
    # If the image isn't present yet, try to load it from the vendor
    # tarball that ships inside the Podroid APK at
    # /usr/local/share/iris/iris-messenger-amd64.tar (built by
    # /home/alca/projects/jrwl-messenger/build-podman-image.sh on the
    # host). The tarball is the obfuscated Nuitka .bin wrapped in a
    # minimal scratch container with glibc; podroid-podman runs it
    # directly. ARM64 is a TODO — see build-podman-image.sh.
    # Pick the vendored tarball for this arch (arm64 native, amd64 emulated).
    _iris_tar=""
    if [ -f /usr/local/share/iris/iris-messenger-arm64.tar ]; then
        _iris_tar=/usr/local/share/iris/iris-messenger-arm64.tar
    elif [ -f /usr/local/share/iris/iris-messenger-amd64.tar ]; then
        _iris_tar=/usr/local/share/iris/iris-messenger-amd64.tar
    fi

    # Load the tarball when the image is MISSING **or when the tarball changed**.
    #
    # The old test was `podman image exists` alone, which is wrong on every
    # upgrade: the squashfs (and therefore the tarball) is replaced wholesale by
    # a new Podroid APK, but the container store lives on the PERSISTENT ext4
    # overlay and still holds the previous localhost/iris-messenger:arm64. The
    # image "exists", so nothing was loaded and the phone silently kept running
    # the OLD pod — an updated Podroid shipped a new gateway that never ran.
    # (Caught live 2026-07-29: the new /api/federation/inbox endpoint would have
    # stayed 404 on both phones after a successful OTA.)
    #
    # The stamp is the tarball's sha256, kept next to the pod's persistent state
    # so it survives reboots but not a data wipe. Hashing ~194 MB costs about a
    # second on ARM64 with crypto extensions — paid once per boot, and far
    # cheaper than shipping an image that never runs.
    if [ -n "${_iris_tar}" ]; then
        _iris_stamp="${IRIS_DATA_DIR}/.iris-image.sha256"
        _iris_want="$(sha256sum "${_iris_tar}" 2>/dev/null | cut -d' ' -f1)"
        _iris_have="$(cat "${_iris_stamp}" 2>/dev/null)"
        if ! podman image exists "${IRIS_IMAGE}" 2>/dev/null; then
            einfo "Loading iris-messenger image from ${_iris_tar} (not present yet)"
            podman load -i "${_iris_tar}" && printf '%s\n' "${_iris_want}" > "${_iris_stamp}"
        elif [ -n "${_iris_want}" ] && [ "${_iris_want}" != "${_iris_have}" ]; then
            einfo "Vendored iris-messenger image changed — reloading from ${_iris_tar}"
            # Drop the running container first: `podman run` binds the image at
            # create time, so a live container would keep the old one alive.
            podman rm -f "${IRIS_CONTAINER_NAME}" 2>/dev/null || true
            if podman load -i "${_iris_tar}"; then
                printf '%s\n' "${_iris_want}" > "${_iris_stamp}"
            else
                # Keep the old image rather than leave the phone with no pod;
                # the stamp stays stale so the next boot retries.
                eerror "podman load failed — continuing with the previously loaded image"
            fi
        fi
    elif ! podman image exists "${IRIS_IMAGE}" 2>/dev/null; then
        eerror "iris-messenger image not present and no vendor tarball found"
        eerror "Expected: ${IRIS_IMAGE}"
        eerror "Or:      /usr/local/share/iris/iris-messenger-{arm64,amd64}.tar"
        return 1
    fi
}

stop() {
    einfo "Stopping iris-messenger pod (if running)"
    podman stop "${IRIS_CONTAINER_NAME}" 2>/dev/null || true
    podman rm -f "${IRIS_CONTAINER_NAME}" 2>/dev/null || true
    return 0
}

status() {
    podman ps -a --filter "name=${IRIS_CONTAINER_NAME}" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
}
