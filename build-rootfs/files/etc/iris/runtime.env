# iris-messenger runtime config (read by /etc/init.d/iris-pod on boot
# and bind-mounted into the container as /etc/iris/runtime.env).
#
# All keys are passed to the container as environment variables
# (using `set -a; . /etc/iris/runtime.env; set +a`).
#
# In production the operator customises these via the iris-android app
# (Settings → Pod config) and they are pushed to the VM via
# podroid-forward's host-bridge.

# ── Identity ──────────────────────────────────────────────────────
# 8-character Iris-ID for this pod. Generated on first boot by
# /etc/init.d/iris-pod's start_pre() if blank.
IRIS_IDENTITY_ID=

# Path inside the container to the long-term private key. The key is
# generated on first boot and stored in the persistent volume.
IRIS_KEYSTORE_DIR=/var/lib/iris/keystore

# ── Gateway bind ──────────────────────────────────────────────────
# Bind to 0.0.0.0 inside the container so podroid-forward (which runs
# on the Android side) can reach the WS port via the guest's eth0.
IRIS_GATEWAY_HOST=0.0.0.0
IRIS_GATEWAY_PORT=9091
IRIS_WEBSOCKET_PORT=9092

# ── Federation (DLM) ──────────────────────────────────────────────
# Multi-gateway DLM federation. Set IRIS_DLM_BOOTSTRAP to a comma-
# separated list of ws://host:port URLs to discover peers via.
IRIS_DLM_HOST=127.0.0.1
IRIS_DLM_PORT=37373
IRIS_DLM_BOOTSTRAP=
IRIS_DLM_AUTO_DISCOVER=true

# ── Trust model ───────────────────────────────────────────────────
# Public keys of trusted DLM federation peers (one base64 key per line).
# Empty = accept any peer with valid handshake (less secure, easier
# for initial peer-to-peer tests).
IRIS_TRUSTED_PEERS=

# ── Storage ───────────────────────────────────────────────────────
# Path inside the container for the message store. Persistent volume
# is bind-mounted at /var/lib/iris.
IRIS_DATA_DIR=/var/lib/iris

# ── Pairing ───────────────────────────────────────────────────────
# 6-digit auth code is required for new devices to pair. After a
# successful pair, a long-lived registration token is issued.
# Set IRIS_PAIRING_CODE to a fixed value to skip the random-code flow
# (useful for kiosk / dev / headless setups).
IRIS_PAIRING_CODE=
IRIS_PAIRING_TIMEOUT_SECONDS=300
